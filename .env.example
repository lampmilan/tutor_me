# Local Docker Compose (Postgres service named `db`)
DATABASE_URL=postgresql+psycopg2://erettsegi:erettsegi@db:5432/erettsegi

# Production: Neon pooled connection string (Cloud Run)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Workspace files on host (mounted into containers). Cloud Run uses /tmp/erettsegi-workspaces.
WORKSPACES_ROOT=/workspaces

# Code execution
EXECUTOR_IMAGE=erettsegi-executor:latest
EXECUTION_TIMEOUT_SECONDS=5
EXECUTION_MEMORY_LIMIT=128m
EXECUTION_CPU_LIMIT=0.5
# subprocess is the reliable default for local Compose and Cloud Run.
# Use docker only when the backend image has a Docker CLI and workspaces are host-bind-mounted.
EXECUTION_BACKEND=subprocess

# Comma-separated browser origins allowed to call the API directly.
# Vercel same-origin /api rewrites do not need this. Do not use * in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: allow Vercel preview URLs in addition to CORS_ORIGINS.
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# /execute and /judge rate limits (per client IP, rolling window). 0 disables.
RATE_LIMIT_EXECUTE_PER_MINUTE=30
RATE_LIMIT_JUDGE_PER_MINUTE=12
RATE_LIMIT_WINDOW_SECONDS=60

# Delete idle workspaces after N days. 0 disables. Sweep runs on API startup
# and via POST /internal/cleanup-workspaces (X-Cleanup-Token).
WORKSPACE_TTL_DAYS=7
CLEANUP_TOKEN=

# AI generation (optional — Phase 8). Keep false for public beta.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_GENERATION_ENABLED=false

# PostHog analytics (optional)
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
